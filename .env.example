# Brew & Bite environment configuration
# Copy this file to `.env` and adjust the values for your environment.
# Never commit real secrets or credentials to version control.

# Flask / application environment: development or production.
# Production must be "production" so secure cookies and fail-fast secrets apply.
APP_ENV=development

# Secret key for signing sessions. Required when APP_ENV=production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Debug mode for the dev server (python app.py).
# Honored only when APP_ENV is not production; production uses gunicorn.
FLASK_DEBUG=true

# Send secure (HTTPS-only) session cookies. Defaults on in production, off in dev.
SESSION_COOKIE_SECURE=false

# Delivery fee in rupees applied to every order.
DELIVERY_FEE=40.00

# Dev server host/port (python app.py). Production is started with gunicorn.
HOST=127.0.0.1
PORT=5000
